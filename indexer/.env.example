HTTP_BIND=0.0.0.0:8080
DATABASE_URL=postgres://indexer:indexer@localhost:5432/indexer

# Live indexing — leave EVM_WS_URL unset to run API-only.
EVM_WS_URL=wss://ethereum-sepolia-rpc.publicnode.com
EVM_CHAIN_ID=11155111
EVM_CONTRACT=0x0000000000000000000000000000000000000000
EVM_START_BLOCK=0

# Must be at least 32 chars.
JWT_SECRET=change-me-to-something-32-chars-or-more

# Must match the dashboard's host (no scheme).
SIWE_DOMAIN=localhost:3000
SIWE_ORIGIN=http://localhost:3000

RUST_LOG=info,indexer=debug
